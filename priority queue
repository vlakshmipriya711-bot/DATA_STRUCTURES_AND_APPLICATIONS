#include <stdio.h>
#include <stdlib.h>

void heapify(int a[10],int n)
{
    int i,k,v,flag =0,j;
    for(i = n/2;i>=1;i--)
    {
        k = i;
        v = a[k];
        flag = 0;

        while(!flag && 2*k<=n)
        {
            j = 2*k;
            if(j<n && a[j]<a[j+1])
                {
                    j = j+1;
                }
                if(v>=a[j])
                {
                    flag = 1;
                }
                else
                {
                    a[k] =a[j];
                    k = j;
                }
            }
        a[k] = v;
        }
    }


int main()
{
    int i,ch,n,a[10];

   while(1)
   {
    printf("\n 1.create heap\n2. extract max\n 3.exit\n");
    printf("\n enter  the choice:");
    scanf("%d",&ch);

       switch(ch)
       {
       case 1:
        {
        printf("\n enter  no of elements :");
        scanf("%d",&n);

        printf("\n enter the element : ");
              for(i=1;i<=n;i++)
              {
                  scanf("%d",&a[i]);
             }
               heapify(a,n);
               printf("\n \n elements after heapification :\n");
               for(i=1;i<=n;i++)
               {
                   printf("%d\t",a[i]);
               }

           break;
        }

       case 2:
        if(n>=1)
        {
            printf("\n \n element deleted is %d\n",a[1]);
            a[1] = a[n];
            n = n-1;

            heapify(a,n);

            if(n!=0)
            {
                printf("\n\n  heap after deleting :\n");
                for(i=1;i<=n;i++)
                {
                    printf("%d\t",a[i]);
                }
            }
        }
        else
        {
            printf("\n No element to delete");
        }
        break;

       default :
        exit(0);
   }
}
return 0;
}

